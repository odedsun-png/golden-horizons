import fs from 'fs';
import path from 'path';

const destinationsFile = path.join(process.cwd(), 'src/data/destinations.json');

type CostItem = {
  item: string;
  range: string;
};

type SourceLink = {
  label: string;
  url: string;
  type?: 'government' | 'official' | 'healthcare' | 'tax' | 'embassy' | 'source';
};

type TextBlock = {
  name?: string;
  label?: string;
  description: string;
  keyTakeaway: string;
  requirements?: string;
  officialLinks?: SourceLink[];
};

type RelatedDestination = {
  slug: string;
  flag: string;
  name: string;
  budgetShort: string;
};

type Scores = Record<string, number>;

export type DestinationDetail = {
  id: string;
  rank: number;
  flag: string;
  name: string;
  ilRank: string;
  ilRankShort: string;
  tagline: string;
  budgetShort: string;
  bestCity: string;
  taxRate: string;
  qolScore: string;
  heroImage: string;
  overview: string;
  cities: string[];
  costCouple: string;
  costSingle: string;
  pros: string[];
  cons: string[];
  costs: CostItem[];
  healthcare: TextBlock;
  visa: TextBlock;
  tax: TextBlock;
  scores: Scores;
  relatedDestinations: RelatedDestination[];

  // New fields for the 26-card SEO/AI destination cards
  bestFor?: string;
  headline?: string;
  healthQuality?: string;
  privateInsurance?: string;
  internationalInsurance?: string;
  englishSpeakingDoctors?: string;
  publicHealthcareAccess?: string;
  emergencyCare?: string;
  bestHealthcareCities?: string[];
  socialSecurityFit?: string;
  socialSecurityDirectDeposit?: string;
  safetySummary?: string;
  lifestyleSummary?: string;
  verificationStatus?: string;
  officialSources?: SourceLink[];
};

type RawDestinationCard = {
  rank?: number;
  country?: string;
  flag?: string | null;
  slug?: string | null;
  headline?: string | null;
  bestFor?: string | null;
  monthlyBudgetUSD?: string | null;
  visaCard?: {
    route?: string | null;
    label?: string | null;
    minimumIncomeRequirement?: string | null;
    incomeAccepted?: string | null;
    proofNotes?: string | null;
    officialLinks?: SourceLink[] | string[];
  };
  healthcareCard?: {
    snapshot?: string | null;
    quality?: string | null;
    publicAccess?: string | null;
    privateCare?: string | null;
    insuranceRequirement?: string | null;
    englishSpeakingCare?: string | null;
    emergencyCare?: string | null;
    bestCitiesForHealthcare?: string[];
    officialLinks?: SourceLink[] | string[];
  };
  socialSecurityCard?: {
    fit?: string | null;
    directDeposit?: string | null;
    paymentNotes?: string | null;
    taxOrReportingNotes?: string | null;
    officialLinks?: SourceLink[] | string[];
  };
  retirementSnapshot?: {
    costAndLifestyle?: string | null;
    safety?: string | null;
    tax?: string | null;
    scores?: Scores;
  };
  verification?: string | null;
  officialSources?: SourceLink[] | string[];
};

